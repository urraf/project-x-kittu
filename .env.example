# ─────────────────────────────────────────────────────────────
# Life of KittuKun: environment variables
# Copy to .env.local for local development. In production, set these in your
# hosting provider's dashboard. NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# MongoDB connection string (MongoDB Atlas recommended)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/lifeofkittukun?retryWrites=true&w=majority
# Optional: database name (otherwise taken from the URI)
MONGODB_DB=

# Public URL of the site (used for SEO, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Secret used to sign admin sessions and captcha tokens (min 32 chars).
# Generate with:  npm run secrets
AUTH_SECRET=

# Starting admin password, as a hash (never the plain password).
# Generate with:  npm run admin:hash-password
# After the admin changes the password in Settings → Password, the hash stored in
# MongoDB takes over. Forgot it?  npm run admin:reset-password
ADMIN_PASSWORD_HASH=

# Shared secret your external cron service sends as "Authorization: Bearer <CRON_SECRET>" (min 24 chars).
# Generate with:  npm run secrets
CRON_SECRET=

# Groq AI (https://console.groq.com/keys)
GROQ_API_KEY=
# Optional: model override. Default: openai/gpt-oss-120b
# (llama-3.3-70b-versatile needs Groq Enterprise access on some accounts)
GROQ_MODEL=
# Optional: reasoning effort for gpt-oss models: low (default, fast) | medium | high
GROQ_REASONING_EFFORT=
# Optional: API base URL override (OpenAI-compatible). Leave empty for Groq.
GROQ_BASE_URL=

# Optional: YouTube Data API key for full channel sync with durations.
# Without it, the public RSS feed is used (latest ~15 uploads, no key needed).
YOUTUBE_API_KEY=
# Channel ID for "Life of KittuKun"
YOUTUBE_CHANNEL_ID=UCz8-XtJDuxb19llG29p2h9A

# Optional: Unsplash access key for stock-photo covers on AI posts.
UNSPLASH_ACCESS_KEY=

# Optional: max image upload size in MB (1–9, default 8)
MAX_UPLOAD_MB=8
