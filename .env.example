# ─────────────────────────────────────────────────────────────
# Life of KittuKun: environment variables
# Copy to .env.local for local development. In production, set these in your
# hosting provider's dashboard. NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# MongoDB connection string (MongoDB Atlas recommended)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/lifeofkittukun?retryWrites=true&w=majority
# Optional: database name (otherwise taken from the URI)
MONGODB_DB=

# Public URL of the site (used for SEO, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Secret used to sign admin sessions and captcha tokens (min 32 chars).
# Generate with:  npm run secrets
AUTH_SECRET=

# Optional starting login email. Once an email is saved in Settings → Login & password,
# the database copy is used. If no email is set anywhere, login uses the password only.
ADMIN_EMAIL=

# Starting admin password, as a hash (never the plain password).
# Generate with:  npm run admin:hash-password
# On the first successful login it is copied into MongoDB, and from then on the
# database is used (you may delete this variable afterwards).
# Forgot the password?  npm run admin:reset-password
ADMIN_PASSWORD_HASH=

# Shared secret your external cron service sends as "Authorization: Bearer <CRON_SECRET>" (min 24 chars).
# Generate with:  npm run secrets
CRON_SECRET=

# Groq AI (https://console.groq.com/keys)
GROQ_API_KEY=
# Optional: model override. Default: openai/gpt-oss-120b
# (llama-3.3-70b-versatile needs Groq Enterprise access on some accounts)
GROQ_MODEL=
# Website chat assistant ("Ask Kittu"). Optional: falls back to GROQ_API_KEY.
GROQ_CHAT_API_KEY=
GROQ_CHAT_MODEL=
# Optional: reasoning effort for gpt-oss models: low (default, fast) | medium | high
GROQ_REASONING_EFFORT=
# Optional: API base URL override (OpenAI-compatible). Leave empty for Groq.
GROQ_BASE_URL=

# Optional: YouTube Data API key for full channel sync with durations.
# Without it, the public RSS feed is used (latest ~15 uploads, no key needed).
YOUTUBE_API_KEY=
# Channel ID for "Life of KittuKun"
YOUTUBE_CHANNEL_ID=UCz8-XtJDuxb19llG29p2h9A

# Optional: Unsplash access key for stock-photo covers on AI posts.
UNSPLASH_ACCESS_KEY=

# Optional: max image upload size in MB (1–9, default 8)
MAX_UPLOAD_MB=8

# ── Sessions (mentorship bookings) ───────────────────────────
# All optional. Without them: free sessions work, paid ones can't be booked,
# no emails are sent, and meeting links are free Jitsi rooms.

# Razorpay payments (https://dashboard.razorpay.com → Account & Settings → API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# No keys yet? Set PAYMENTS_DEMO=true to try paid bookings with a practice checkout
# (no real money). It switches off automatically once the keys above are set.
PAYMENTS_DEMO=
# Webhook (recommended): Razorpay → Webhooks → URL https://YOUR-SITE/api/payments/razorpay/webhook,
# events "payment.captured" and "order.paid". Paste the secret you chose here.
RAZORPAY_WEBHOOK_SECRET=

# Email. Use ONE of these HTTPS email APIs (SMTP is blocked on many hosts, incl. Render free).
# Brevo: https://app.brevo.com → SMTP & API → API keys (300 emails/day free)
BREVO_API_KEY=
# Resend: https://resend.com/api-keys (needs a verified domain to email anyone but yourself)
RESEND_API_KEY=
# Or Gmail SMTP with an App Password (Google Account → Security → 2-Step Verification → App passwords).
# Works on paid hosts; Render's FREE plan blocks SMTP ports, so use Brevo there.
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com   (default for Gmail addresses)
# SMTP_PORT=465
# Sender shown to students. Must be a verified sender in Brevo/Resend (or the SMTP_USER address).
EMAIL_FROM="Life of KittuKun <lifeofkittukunweb@gmail.com>"

# "Continue with Google" for student accounts (optional).
# Google Cloud → APIs & Services → Credentials → OAuth client ID → type "Web application".
# Authorised redirect URI: https://YOUR-SITE/api/account/google/callback
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=

# Google Meet links + calendar invites (optional; otherwise Jitsi links are used).
# Create a "Desktop app" OAuth client with the Google Calendar API enabled,
# then run:  npm run google:auth   to get the refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Calendar to create events in. "primary" = the account's main calendar.
GOOGLE_CALENDAR_ID=primary

# Search engines (optional). Only needed if you verify with the "HTML tag" method
# instead of DNS: paste just the content="..." value.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
